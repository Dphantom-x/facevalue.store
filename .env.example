# FaceValue — environment template. Copy to .env.local for local dev, or set these
# in the Railway dashboard for the pilot deploy. NEVER commit real secrets (.env.local is gitignored).

# ── Persistence ────────────────────────────────────────────────────────────────
# Where the SQLite file lives. In production this MUST point at the mounted
# persistent volume, or the DB is wiped on every redeploy.
# Railway: add a Volume mounted at /data, then set:
FV_DB_PATH=/data/facevalue.db

# ── Secrets (CHANGE THESE for any public deploy) ─────────────────────────────────
# HMAC key that signs ticket QR tokens. If this rotates, every issued QR stops
# validating — set it ONCE to a long random string and keep it stable.
QR_SECRET=change-me-to-a-long-random-string
# Salt for the simulated World-ID nullifier (until real World ID is wired).
WORLDID_SIM_SECRET=change-me-too

# Seed account passwords. The defaults are PUBLIC (they're in CLAUDE.md) — you MUST
# override both before exposing the app, or anyone can log into your Studio/admin.
FV_VENDOR_PASSWORD=set-a-strong-vendor-password
FV_ADMIN_PASSWORD=set-a-strong-admin-password
# Code a new vendor must enter to self-register a vendor account.
FV_VENDOR_CODE=PILOT-VENDOR

# ── Payments ─────────────────────────────────────────────────────────────────────
# "mock" = fully testable hold/capture with no real money (default, good for the
# code-gate pilot). Switch to "stripe" only at go-live.
PAYMENTS_MODE=mock
# Stripe go-live (manual-capture). Leave unset while PAYMENTS_MODE=mock.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── World ID (real proof-of-personhood) ──────────────────────────────────────────
# Set WORLDID_REAL=1 only after the IDKit integration is wired AND you've registered
# a World ID app. Device-level verification is non-biometric (legal in NYC).
# WORLDID_REAL=1
# WORLDID_APP_ID=app_staging_...
# WORLDID_ACTION=facevalue-verify

# ── Valiron (agent trust + x402 stretch) ─────────────────────────────────────────
# Trust reads need no key. The operator key is only for the x402 paywall demo.
# VALIRON_OPERATOR_KEY=val_op_...
